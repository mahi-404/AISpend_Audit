# -----------------------------------------------------------------------------
# CREDEX - AI SPEND AUDIT: ENVIRONMENT VARIABLES EXAMPLE
# -----------------------------------------------------------------------------
# Copy this file to .env.local and populate with your own values.
# DO NOT commit the .env.local file to version control.

# SITE CONFIGURATION
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SUPABASE (Database & Auth)
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI AUDIT ENGINE (LLM Summary Service)
# Anthropic is the primary provider for high-end consultant summaries.
ANTHROPIC_API_KEY=your-anthropic-key

# OpenAI is used as a fallback or for specific coding analysis.
OPENAI_API_KEY=your-openai-key

# NOTIFICATIONS & LEADS
# Resend is used for sending strategic roadmap PDFs to enterprise leads.
RESEND_API_KEY=re_your_api_key

# SECURITY
# Used for encrypting sensitive audit tokens if needed.
AUDIT_SECRET_TOKEN=your-random-secret-string
